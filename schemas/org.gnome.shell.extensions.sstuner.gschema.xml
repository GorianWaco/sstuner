<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.sstuner"
          path="/org/gnome/shell/extensions/sstuner/">
    <key name="percent" type="i">
      <default>100</default>
      <range min="55" max="140"/>
      <summary>Brightness</summary>
      <description>55–100: podświetlenie monitora (DDC). Powyżej 100: boost programowy.</description>
    </key>
    <key name="contrast" type="i">
      <default>0</default>
      <range min="-25" max="25"/>
      <summary>Kontrast</summary>
      <description>Korekcja kontrastu obrazu. 0 = bez zmian, ujemne ściemnia różnice, dodatnie je wzmacnia.</description>
    </key>
    <key name="saturation" type="i">
      <default>0</default>
      <range min="-25" max="25"/>
      <summary>Nasycenie</summary>
      <description>Korekcja nasycenia kolorów. 0 = bez zmian, ujemne szarzeje, dodatnie ożywia barwy.</description>
    </key>
    <key name="eq-bass" type="i">
      <default>0</default>
      <range min="-12" max="12"/>
      <summary>Equalizer: bas</summary>
      <description>Wzmocnienie niskich tonów w dB. 0 = bez zmian.</description>
    </key>
    <key name="eq-mid" type="i">
      <default>0</default>
      <range min="-12" max="12"/>
      <summary>Equalizer: średnie</summary>
      <description>Wzmocnienie średnich tonów w dB. 0 = bez zmian.</description>
    </key>
    <key name="eq-treble" type="i">
      <default>0</default>
      <range min="-12" max="12"/>
      <summary>Equalizer: sopran</summary>
      <description>Wzmocnienie wysokich tonów w dB. 0 = bez zmian.</description>
    </key>
    <key name="eq-spatial" type="i">
      <default>0</default>
      <range min="0" max="100"/>
      <summary>Dźwięk przestrzenny</summary>
      <description>Szerokość sceny stereo. 0 = bez zmian, 100 = maksymalna przestrzeń. Działa też w grach (PipeWire).</description>
    </key>
    <key name="picture-presets" type="s">
      <default>'[{"id":"neutral","name":"Neutralny","percent":100,"contrast":0,"saturation":0},{"id":"night","name":"Noc","percent":55,"contrast":-6,"saturation":0},{"id":"day","name":"Dzień","percent":120,"contrast":4,"saturation":0}]'</default>
      <summary>Presety obrazu</summary>
      <description>JSON z presetami jasności, kontrastu i nasycenia.</description>
    </key>
    <key name="sound-presets" type="s">
      <default>'[{"id":"flat","name":"Płaski","bass":0,"mid":0,"treble":0,"spatial":0},{"id":"bass","name":"Bas","bass":7,"mid":-1,"treble":-2,"spatial":0},{"id":"voice","name":"Głos","bass":-3,"mid":5,"treble":3,"spatial":15},{"id":"bright","name":"Jasny","bass":-2,"mid":1,"treble":6,"spatial":25},{"id":"spatial","name":"Przestrzeń","bass":1,"mid":0,"treble":2,"spatial":60}]'</default>
      <summary>Presety dźwięku</summary>
      <description>JSON z presetami equalizera i dźwięku przestrzennego.</description>
    </key>
    <key name="picture-preset-active" type="s">
      <default>''</default>
      <summary>Aktywny preset obrazu</summary>
    </key>
    <key name="sound-preset-active" type="s">
      <default>''</default>
      <summary>Aktywny preset dźwięku</summary>
    </key>
    <key name="picture-expanded" type="b">
      <default>false</default>
      <summary>Rozwinięta sekcja obrazu</summary>
    </key>
    <key name="sound-expanded" type="b">
      <default>false</default>
      <summary>Rozwinięta sekcja dźwięku</summary>
    </key>
    <key name="use-ddc" type="b">
      <default>true</default>
      <summary>Używaj DDC/CI</summary>
      <description>Steruj podświetleniem monitora przez ddcutil, gdy jest dostępne.</description>
    </key>
    <key name="brightness-up" type="as">
      <default><![CDATA[['<Super>Page_Up', 'XF86MonBrightnessUp']]]></default>
      <summary>Rozjaśnij</summary>
    </key>
    <key name="brightness-down" type="as">
      <default><![CDATA[['<Super>Page_Down', 'XF86MonBrightnessDown']]]></default>
      <summary>Przyciemnij</summary>
    </key>
  </schema>
</schemalist>

#: extension.js:628
#, javascript-format
msgid "Decrease %s"
msgstr "Зменшити: %s"

#: extension.js:629
#, javascript-format
msgid "Increase %s"
msgstr "Збільшити: %s"

#: extension.js:794
msgid "Save preset"
msgstr "Зберегти пресет"

#: extension.js:807
msgid "Preset name"
msgstr "Назва пресету"

#: extension.js:815
msgid "Save name"
msgstr "Зберегти назву"

#: extension.js:821
msgid "Cancel"
msgstr "Скасувати"

#: extension.js:868
#, javascript-format
msgid "Load preset %s"
msgstr "Завантажити пресет %s"

#: extension.js:967
msgid "Overwrite with current values"
msgstr "Перезаписати поточними значеннями"

#: extension.js:968
msgid "Rename"
msgstr "Перейменувати"

#: extension.js:969 prefs.js:185
msgid "Delete"
msgstr "Видалити"

#: extension.js:1101 extension.js:1176 prefs.js:27 prefs.js:30 prefs.js:75
msgid "Sound"
msgstr "Звук"

#: extension.js:1116
msgid "Reset bass to 0 dB"
msgstr "Скинути бас до 0 дБ"

#: extension.js:1117 presets.js:16
msgid "Bass"
msgstr "Бас"

#: extension.js:1129
msgid "Reset mid to 0 dB"
msgstr "Скинути середні до 0 дБ"

#: extension.js:1130
msgid "Mid"
msgstr "Середні"

#: extension.js:1142
msgid "Reset treble to 0 dB"
msgstr "Скинути високі до 0 дБ"

#: extension.js:1143
msgid "Treble"
msgstr "Високі"

#: extension.js:1156
msgid "Reset spatial sound to 0%"
msgstr "Скинути просторовий звук до 0%"

#: extension.js:1157
msgid "Spatial sound"
msgstr "Просторовий звук"

#: extension.js:1160
msgid "off"
msgstr "вимк"

#: prefs.js:20
#, javascript-format
msgid "Bass %s dB, mid %s dB, treble %s dB, spatial %s%%"
msgstr "Бас %s дБ, середні %s дБ, високі %s дБ, простір %s%%"

#: prefs.js:31
msgid ""
"Equalizer and spatial sound via PipeWire. 0 = unchanged. Values are restored "
"after login."
msgstr ""
"Еквалайзер і просторовий звук через PipeWire. 0 — без змін. Значення "
"відновлюються після входу в систему."

#: prefs.js:35
msgid "Bass at startup"
msgstr "Бас під час запуску"

#: prefs.js:35
msgid "Shelf ~120 Hz, range −12…+12 dB."
msgstr "Шельфовий фільтр ~120 Гц, діапазон −12…+12 дБ."

#: prefs.js:36
msgid "Mid at startup"
msgstr "Середні під час запуску"

#: prefs.js:36
msgid "Peak ~1 kHz, range −12…+12 dB."
msgstr "Піковий фільтр ~1 кГц, діапазон −12…+12 дБ."

#: prefs.js:37
msgid "Shelf ~6 kHz, range −12…+12 dB."
msgstr "Шельфовий фільтр ~6 кГц, діапазон −12…+12 дБ."

#: prefs.js:37
msgid "Treble at startup"
msgstr "Високі під час запуску"

#: prefs.js:55
msgid "Spatial sound at startup"
msgstr "Просторовий звук під час запуску"

#: prefs.js:56
msgid "0 = unchanged stereo, 100 = widest stage. Works in games too."
msgstr "0 — звичайне стерео, 100 — найширша сцена. Працює і в іграх."

#: prefs.js:70
msgid "Sound presets"
msgstr "Пресети звуку"

#: prefs.js:71
msgid "Click = load, + = save. Bass / mid / treble / spatial."
msgstr "Клік — завантажити, + — зберегти. Бас / середні / високі / простір."

#: prefs.js:88
msgid "Reset all sliders"
msgstr "Скинути всі повзунки"

#: prefs.js:89
msgid "Equalizer 0 dB, spatial sound 0%. Presets are kept."
msgstr "Еквалайзер 0 дБ, просторовий звук 0%. Пресети залишаться."

#: prefs.js:92
msgid "Reset"
msgstr "Скинути"

#: prefs.js:149
msgid "Load"
msgstr "Завантажити"

#: prefs.js:170
msgid "Overwrite with current sliders"
msgstr "Перезаписати поточними значеннями повзунків"

#: prefs.js:201
msgid "Save current sliders as a new preset"
msgstr "Зберегти поточні значення як новий пресет"

#: prefs.js:203
#, javascript-format
msgid "Limit of %d presets reached."
msgstr "Досягнуто ліміту пресетів: %d."

#: prefs.js:204
#, javascript-format
msgid "Will be saved as “%s”."
msgstr "Буде збережено як «%s»."

#: prefs.js:207
msgid "Add"
msgstr "Додати"

#: prefs.js:229
msgid "Restore factory presets"
msgstr "Відновити заводські пресети"

#: prefs.js:230
msgid ""
"Adds the missing ones (Bass, Voice, Spatial…). Your own presets are kept."
msgstr "Додає відсутні (Бас, Голос, Простір…). Ваші пресети не видаляються."

#: prefs.js:233
msgid "Restore"
msgstr "Відновити"

#: presets.js:15
msgid "Flat"
msgstr "Рівний"

#: presets.js:17
msgid "Voice"
msgstr "Голос"

#: presets.js:18
msgid "Bright"
msgstr "Яскравий"

#: presets.js:19
msgid "Spatial"
msgstr "Простір"

#: extension.js:628
#, javascript-format
msgid "Decrease %s"
msgstr "Уменьшить: %s"

#: extension.js:629
#, javascript-format
msgid "Increase %s"
msgstr "Увеличить: %s"

#: extension.js:794
msgid "Save preset"
msgstr "Сохранить пресет"

#: extension.js:807
msgid "Preset name"
msgstr "Название пресета"

#: extension.js:815
msgid "Save name"
msgstr "Сохранить название"

#: extension.js:821
msgid "Cancel"
msgstr "Отмена"

#: extension.js:868
#, javascript-format
msgid "Load preset %s"
msgstr "Загрузить пресет %s"

#: extension.js:967
msgid "Overwrite with current"
msgstr "Перезаписать текущими"

#: extension.js:968
msgid "Rename"
msgstr "Переименовать"

#: extension.js:969 prefs.js:185
msgid "Delete"
msgstr "Удалить"

#: extension.js:1101 extension.js:1176 prefs.js:27 prefs.js:30 prefs.js:75
msgid "Sound"
msgstr "Звук"

#: extension.js:1116
msgid "Reset bass to 0 dB"
msgstr "Сбросить бас на 0 дБ"

#: extension.js:1117 presets.js:16
msgid "Bass"
msgstr "Бас"

#: extension.js:1129
msgid "Reset mid to 0 dB"
msgstr "Сбросить средние на 0 дБ"

#: extension.js:1130
msgid "Mid"
msgstr "Средние"

#: extension.js:1142
msgid "Reset treble to 0 dB"
msgstr "Сбросить высокие на 0 дБ"

#: extension.js:1143
msgid "Treble"
msgstr "Высокие"

#: extension.js:1156
msgid "Reset spatial sound to 0%"
msgstr "Сбросить объёмный звук на 0%"

#: extension.js:1157
msgid "Spatial sound"
msgstr "Объёмный звук"

#: extension.js:1160
msgid "off"
msgstr "выкл"

#: prefs.js:20
#, javascript-format
msgid "Bass %s dB, mid %s dB, treble %s dB, spatial %s%%"
msgstr "Бас %s дБ, средние %s дБ, высокие %s дБ, объём %s%%"

#: prefs.js:31
msgid ""
"Equalizer and spatial sound via PipeWire. 0 = unchanged. Values are restored "
"after login."
msgstr ""
"Эквалайзер и объёмный звук через PipeWire. 0 — без изменений. Значения "
"восстанавливаются после входа в систему."

#: prefs.js:35
msgid "Bass at startup"
msgstr "Бас при запуске"

#: prefs.js:35
msgid "Shelf ~120 Hz, range −12…+12 dB."
msgstr "Полка ~120 Гц, диапазон −12…+12 дБ."

#: prefs.js:36
msgid "Mid at startup"
msgstr "Средние при запуске"

#: prefs.js:36
msgid "Peak ~1 kHz, range −12…+12 dB."
msgstr "Пик ~1 кГц, диапазон −12…+12 дБ."

#: prefs.js:37
msgid "Shelf ~6 kHz, range −12…+12 dB."
msgstr "Полка ~6 кГц, диапазон −12…+12 дБ."

#: prefs.js:37
msgid "Treble at startup"
msgstr "Высокие при запуске"

#: prefs.js:55
msgid "Spatial sound at startup"
msgstr "Объёмный звук при запуске"

#: prefs.js:56
msgid "0 = unchanged stereo, 100 = widest stage. Works in games too."
msgstr "0 — обычное стерео, 100 — самая широкая сцена. Работает и в играх."

#: prefs.js:70
msgid "Sound presets"
msgstr "Пресеты звука"

#: prefs.js:71
msgid "Click = load, + = save. Bass / mid / treble / spatial."
msgstr "Клик — загрузить, + — сохранить. Бас / средние / высокие / объём."

#: prefs.js:88
msgid "Reset all sliders"
msgstr "Сбросить все ползунки"

#: prefs.js:89
msgid "Equalizer 0 dB, spatial sound 0%. Presets are kept."
msgstr "Эквалайзер 0 дБ, объёмный звук 0%. Пресеты останутся."

#: prefs.js:92
msgid "Reset"
msgstr "Сбросить"

#: prefs.js:149
msgid "Load"
msgstr "Загрузить"

#: prefs.js:170
msgid "Overwrite with current sliders"
msgstr "Перезаписать текущими ползунками"

#: prefs.js:201
msgid "Save current sliders as a new preset"
msgstr "Сохранить текущие ползунки как новый пресет"

#: prefs.js:203
#, javascript-format
msgid "Limit of %d presets reached."
msgstr "Достигнут лимит пресетов: %d."

#: prefs.js:204
#, javascript-format
msgid "Will be saved as “%s”."
msgstr "Будет сохранён как «%s»."

#: prefs.js:207
msgid "Add"
msgstr "Добавить"

#: prefs.js:229
msgid "Restore factory presets"
msgstr "Восстановить заводские пресеты"

#: prefs.js:230
msgid ""
"Adds the missing ones (Bass, Voice, Spatial…). Your own presets are kept."
msgstr "Добавляет недостающие (Бас, Голос, Объём…). Ваши пресеты не удаляются."

#: prefs.js:233
msgid "Restore"
msgstr "Восстановить"

#: presets.js:15
msgid "Flat"
msgstr "Ровный"

#: presets.js:17
msgid "Voice"
msgstr "Голос"

#: presets.js:18
msgid "Bright"
msgstr "Яркий"

#: presets.js:19
msgid "Spatial"
msgstr "Объём"
